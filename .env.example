# GongGPT Environment Variables
# Copy this file to .env and fill in your credentials

# Gong API credentials
GONG_ACCESS_KEY=your_gong_access_key_here
GONG_SECRET_KEY=your_gong_secret_key_here

# Anthropic API key for Claude analysis and chatbot
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Flask secret key (optional - auto-generated if not set)
FLASK_SECRET_KEY=your_random_secret_key_here
